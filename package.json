{
	"version": "2.0.0-next.1",
	"name": "status-sharding",
	"description": "A sharding manager that is easy to use and has a lot of features.",
	"repository": "https://github.com/Status-Team/Status-Sharding",
	"author": "Digital39999",
	"type": "module",
	"scripts": {
		"build": "tsup src/index.ts src/core.ts --clean --dts --format esm,cjs --sourcemap --target node20",
		"watch": "tsup src/index.ts src/core.ts --dts --format esm,cjs --sourcemap --target node20 --watch",
		"typecheck": "tsc --noEmit",
		"test": "pnpm run typecheck && pnpm run build",
		"docs": "typedoc",
		"start": "node --no-deprecation dist/index.js",
		"lint": "eslint . --cache --cache-location node_modules/.cache/eslint",
		"lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint",
		"check": "pnpm run typecheck && pnpm run lint",
		"docker:start": "pnpm start",
		"updates": "pnpm dlx npm-check-updates -i --format group"
	},
	"main": "dist/index.cjs",
	"types": "./dist/index.d.ts",
	"typesVersions": {
		"*": {
			"core": [
				"./dist/core.d.ts"
			]
		}
	},
	"exports": {
		".": {
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"default": "./dist/index.js"
		},
		"./core": {
			"require": {
				"types": "./dist/core.d.cts",
				"default": "./dist/core.cjs"
			},
			"import": {
				"types": "./dist/core.d.ts",
				"default": "./dist/core.js"
			},
			"default": "./dist/core.js"
		}
	},
	"license": "GPL-3.0",
	"engines": {
		"node": ">=20.0.0"
	},
	"peerDependencies": {
		"@discordjs/core": ">=2.2.1",
		"@discordjs/rest": ">=2.6.0",
		"@discordjs/ws": ">=2.0.3",
		"discord.js": ">=14.14.1"
	},
	"peerDependenciesMeta": {
		"@discordjs/core": {
			"optional": true
		},
		"@discordjs/rest": {
			"optional": true
		},
		"@discordjs/ws": {
			"optional": true
		}
	},
	"packageManager": "pnpm@10.33.0",
	"devDependencies": {
		"@discordjs/core": "^2.2.1",
		"@discordjs/rest": "^2.6.0",
		"@discordjs/ws": "^2.0.3",
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/node": "^26.1.2",
		"discord.js": "^14.27.0",
		"eslint": "^10.8.0",
		"tsup": "^8.5.1",
		"typedoc": "^0.28.14",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.66.0"
	},
	"files": [
		"dist/**/*",
		"src/**/*",
		"sharding.md"
	]
}
